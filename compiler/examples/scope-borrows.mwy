debug : @"debug"

read <int32> : (value <int32>) {
    view : &value
    -> *view
}
same <boolean> : (value <int32>, original <&int32>) { -> &value == original }

owner := 7
debug.print(same(owner, &owner))
debug.print(read(owner))
next : owner.{ view : &$; -> *view + 1 }
debug.print(next)
owner = 9
view : (&owner).{ -> &*$ }
debug.print(view == &owner)
debug.print(*view)
owner = 10
debug.print(owner)
