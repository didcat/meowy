debug : @"debug"
time : @"time"

work : @"./work.mwy"

status <int32> := 0

%squares <int32[4]>
%squares.deadline(time.after(time.Second))

%squares >> work.square(2)
%squares >> work.square(3)
%squares >> work.square(4)

results : << %squares
index <usize> := 1

'loop {
    | index > results.size() | 'loop.leave()

    result : &(results[index])
    | *result <error> | {
        status = 1
        debug.print("Result {index}: {*result}")
        index = index + 1
        'loop.restart()
    }

    debug.print("Result {index}: {*result}")
    index = index + 1
    'loop.restart()
}

-> status
