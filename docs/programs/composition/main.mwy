debug : @"debug"
readings : @"./readings.mwy"

reading : 21
    .(readings.label, "rack-a")
    .(readings.check)

debug.print("Reading: {reading} {reading.unit} from {reading.sensor}")
| reading.checked | debug.print("Within the sensor range")

# The predicate tests the full shape; the body uses its proof. #
| reading <readings.Checked> | {
    checked : reading~<readings.Checked>
    debug.print("Composition retained the fields and primary")
}

value <int32> : reading
debug.print("Copied primary: {value}")
