d : @"debug"

show <null> : (flag <boolean>) {
    base : {
        d.print("source")
        | flag | -> n : 2
        | !flag | -> n : 3
        d.print("source tail")
    }
    first : {
        -> n <int32> : ((base.n))
        d.print("first tail")
    }
    copy : {
        -> ((first))
        d.print("copy tail")
    }
    row : {
        -> value <int32> : ((copy.n))
        -> echo <int32> : ((base.n))
        d.print("row tail")
    }
    d.print(row.value)
    d.print(row.echo)
}

show(true)
show(false)
solo : { -> n : 7 }
own <int32> : { -> ((solo.n)) }
d.print(own)
