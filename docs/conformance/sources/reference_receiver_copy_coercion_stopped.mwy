d : @"debug"
n : 7
p : &n
record : p.{
    d.print("source")
    -> $
    -> tag : true
    d.print("source tail")
}
record.{
    d.print("receiver")
    copy : $
    first <&int32> : copy
    d.print(first == p)
    copy.{
        d.print("nested")
        alias : (($))
        maybe <&int32><null> : alias
        | maybe<&int32> | d.print((maybe~<&int32>) == p)
        d.panic("stop")
        last <&int32> : alias
        d.print("unreached")
    }
}
