d : @"debug"
receiver <int32> : (n <int32>) { d.print("receiver {n}"); -> n }

show <null> : (n <int32>) {
    row : receiver(n).{
        d.print("source {n}")
        -> $
        -> z : $ + 1
        -> a : true
        d.print("source tail {n}")
    }
    out : row.{
        alias : (($))
        copy : 'made {
            { 'made -> ((alias)); d.print("copy tail {n}") }
        }
        inner : $.{ copy : { -> $ }; d.print(copy.z) }
        more : {
            -> copy
            -> extra : 11
            d.print("outer tail {n}")
        }
        d.print(more)
        d.print(more.a)
        d.print(more.z)
        d.print(more.extra)
        d.print("receiver tail {n}")
    }
}
show(3)
show(5)
