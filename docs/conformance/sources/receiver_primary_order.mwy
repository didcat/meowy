d : @"debug"
show <null> : (n <int32>) {
    row : n.{
        d.print("source {n}")
        -> $
        -> tag : true
        d.print("source tail {n}")
    }
    out : row.{
        alias : (($))
        copy <int32> : alias
        maybe <int32><null> : alias
        d.print(copy)
        | maybe <int32> | d.print(maybe)
        inner : $.{ copy <int32> : $; -> copy }
        d.print(inner)
        -> copy
        d.print("receiver tail {n}")
    }
    d.print(out)
}
show(3)
show(5)
