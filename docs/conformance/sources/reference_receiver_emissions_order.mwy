d : @"debug"
mark <&int32> : (p <&int32>) { d.print("source"); -> p }
read <boolean> : (p <&int32>) {
    byte <uint8> : 7
    choose := true
    -> mark(p).{
        d.print("body")
        -> $
        -> z : byte
        -> a : true
        d.print("source tail")
    }.{
        d.print("receiver")
        copy : 'target {
            d.print("copy")
            { 'target -> (($)~<{ -> <&int32>; a <boolean>; z <uint8> }>) }
            d.print("copy tail")
        }
        d.print(copy.a)
        view <&int32> : copy
        d.print(view == p)
        | choose | $.{
            d.print("nested")
            nested : { -> $ }
            d.print(nested.z)
        }
        -> copy.a
        d.print("receiver tail")
    }
    d.print("function tail")
}
n : 7
d.print(read(&n))
({ -> &n; -> tag : true }).{ copy : { -> $ }; d.print(copy.tag) }
