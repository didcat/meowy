d : @"debug"
<Byte> : <uint8><boolean>
<OtherByte> : <uint8><string>
<Decimal> : <float32><boolean>
<OtherDecimal> : <float32><string>
<Text> : <string><boolean>
<Empty> : <null><boolean>
<OtherEmpty> : <null><string>
<T> : <int32><boolean>
<U> : <int32><string>
<Items> : <int32[1]><boolean>
<OtherItems> : <int32[1]><string>

choice <boolean><string> : true
| choice <boolean> | {
    small <uint8> : 255
    byte : small.{ -> $; -> tag : true }
    bytes <Byte[2]><OtherByte[2]> : [byte, choice]
    | bytes <Byte[2]> | d.print(bytes[1])
    number <float32> : 1.5
    decimal : number.{ -> $; -> tag : true }
    decimals <Decimal[2]><OtherDecimal[2]> : [decimal, choice]
    | decimals <Decimal[2]> | d.print(decimals[1])
    text : "cat".{ -> $; -> tag : true }
    texts <Text[2]><string[2]> : [text, choice]
    | texts <Text[2]> | d.print(texts[1])
    empty : 3.{ -> tag : true }
    empties <Empty[2]><OtherEmpty[2]> : [empty, choice]
    | empties <Empty[2]> | d.print(empties[1])
    mutable := 3.{ -> $; -> tag : true }
    saved : mutable
    mutable = 4.{ -> $; -> tag : true }
    copies <T[3]><U[3]> : [saved, mutable, choice]
    | copies <T[3]> | { d.print(copies[1]); d.print(copies[2]) }
    list : 5.{ -> [$]; -> tag : true }
    lists <Items[2]><OtherItems[2]> : [list, choice]
    | lists <Items[2]> | {
        first : lists[1]
        | first <int32[1]> | d.print(first[1])
    }
}
